<script>
  // Matrix digital-rain canvas (hero background, desktop only). Delta-time
  // loop with per-column speed, glowing heads and staggered wrap-around so
  // the rain loops seamlessly. Pauses offscreen / hidden tab, off for reduced
  // motion. Phones get a static CSS rain backdrop instead (zero JS cost).
  (() => {
    const canvas = document.getElementById("matrix");
    if (!canvas || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (canvas.offsetParent === null) return; // hidden on phones: static CSS backdrop instead, zero JS cost
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;
    const glyphs = "アイウエオカキクケコサシスセソ0123456789ABCDEF$#*+-<>".split("");
    const pick = () => glyphs[(Math.random() * glyphs.length) | 0];
    const font = 18;
    const TRAIL = 10;
    const FADE = 0.12;
    let w = 0, h = 0, rows = 0, streams = [];
    function spawn(yMin, yMax) {
      return {
        y: yMin + Math.random() * (yMax - yMin),
        speed: 5 + Math.random() * 9, // rows per second
        chars: Array.from({ length: TRAIL }, pick),
      };
    }
    function resize() {
      const r = canvas.parentElement.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = Math.max(1, r.width); h = Math.max(1, r.height);
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      rows = Math.ceil(h / font);
      const n = Math.ceil(w / font);
      streams = Array.from({ length: n }, () => spawn(-rows, 0));
    }
    resize();
    window.addEventListener("resize", resize);
    let running = true;
    new IntersectionObserver(([e]) => { running = e.isIntersecting; }).observe(canvas);
    document.addEventListener("visibilitychange", () => { running = !document.hidden; });
    let last = performance.now();
    function draw(now) {
      requestAnimationFrame(draw);
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      if (!running) return;
      ctx.fillStyle = `rgba(11, 11, 14, ${FADE})`;
      ctx.fillRect(0, 0, w, h);
      ctx.font = font + "px monospace";
      ctx.textBaseline = "top";
      for (let i = 0; i < streams.length; i++) {
        const s = streams[i];
        s.y += s.speed * dt;
        if (s.y - TRAIL > rows) {
          streams[i] = spawn(-TRAIL * 2, -1); // staggered re-entry: seamless loop
          continue;
        }
        const x = i * font;
        const head = Math.floor(s.y);
        for (let k = 0; k < TRAIL; k++) {
          const row = head - k;
          if (row < 0 || row > rows) continue;
          if (k === 0 && Math.random() < 0.15) s.chars[0] = pick(); // mutate head
          const a = 1 - k / TRAIL;
          ctx.fillStyle = k === 0 ? "#c8ffe2" : `rgba(61, 220, 132, ${(a * 0.85).toFixed(2)})`;
          ctx.fillText(s.chars[k], x, row * font);
        }
      }
    }
    requestAnimationFrame(draw);
  })();
</script>
