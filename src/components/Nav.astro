---
const links = [
  { href: "#features", label: "Features" },
  { href: "#tour", label: "Tour" },
  { href: "#setup", label: "Setup" },
  { href: "#specs", label: "Specs" },
  { href: "#download", label: "Download" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-mint/20 bg-abyss/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="flex items-center gap-3">
      <img src="logo.webp" alt="NativeCode logo" class="h-9 w-9 rounded-sm object-cover" />
      <span class="font-mono2 text-lg font-bold tracking-tight">native<span class="text-mint">code</span></span>
    </a>
    <div class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class="font-mono2 text-[13px] font-medium tracking-wide text-warm transition hover:text-mint">{l.label}</a>
      ))}
      <a href="https://github.com/zenithblue-dev/nativecode-ai" class="rounded-sm bg-mint px-4 py-2 font-mono2 text-[13px] font-bold text-abyss transition hover:bg-focus">GitHub</a>
    </div>
    <button id="menu-btn" class="rounded-sm border border-white/15 p-2 md:hidden" aria-label="Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden border-t border-white/10 px-4 py-3 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="block rounded-sm px-2 py-2 font-mono2 text-sm text-warm hover:bg-white/5 hover:text-mint">{l.label}</a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
